<Window x:Class="MacBridgeSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MacBridge Setup"
        Icon="pack://application:,,,/app.ico"
        Width="700" Height="490"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Background="#0B0E14"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#1E2636" BorderThickness="1" Background="#0B0E14">
        <Grid Margin="22,0,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/icon.png" Width="20" Height="20" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TxtWinTitle" Text="MacBridge 安装向导" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <Border Background="#152238" BorderBrush="#253A5E" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTopBadge" Text="安装向导 v1.0.1" FontSize="10.5" Foreground="#93C5FD"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnLang" Style="{StaticResource SmallPillBtn}" Content="中文 / EN" Click="BtnLang_Click" Margin="0,0,10,0" Padding="9,3"/>
                    <Button x:Name="BtnMin" Style="{StaticResource ChromeBtn}" Click="BtnMin_Click">
                        <Path Data="M0,4 H10" Stroke="#94A3B8" StrokeThickness="1.3" Width="10" Height="8" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource ChromeBtn}" Click="BtnClose_Click" Margin="4,0,0,0">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#94A3B8" StrokeThickness="1.3" Width="9" Height="9"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="0,8,0,14">
                <!-- Page 0: Install Setup Options -->
                <StackPanel x:Name="PageSetup" Visibility="Visible">
                    <Border Background="#121722" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="pack://application:,,,/icon.png" Width="52" Height="52" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHeroTitle" Text="MacBridge" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock x:Name="TxtHeroSub" Text="纯用户态 Mac &lt;-&gt; Windows USB 直连高速 IP 网桥（免测试签名）" FontSize="12.5" Foreground="#94A3B8" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Install Path Card -->
                    <Border Background="#121722" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="LblInstallDir" Text="安装目录" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtInstallDir" Grid.Column="0"
                                         Background="#080B10" Foreground="#F8FAFC" CaretBrush="#60A5FA"
                                         BorderBrush="#263248" BorderThickness="1" Padding="10,7"
                                         FontSize="12.5" VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnBrowse" Grid.Column="2" Style="{StaticResource GhostBtn}" Content="浏览..." Click="BtnBrowse_Click" Padding="14,7"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Install Checkboxes Card -->
                    <Border Background="#121722" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="16,13">
                        <StackPanel>
                            <TextBlock x:Name="LblOptions" Text="安装选项" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkDesktop" Style="{StaticResource DarkCheckBox}" IsChecked="True" Content="创建桌面快捷方式（MacBridge）"/>
                            <CheckBox x:Name="ChkStartMenu" Style="{StaticResource DarkCheckBox}" IsChecked="True" Content="创建开始菜单快捷方式（含驱动还原与卸载入口）"/>
                            <CheckBox x:Name="ChkLaunchAfter" Style="{StaticResource DarkCheckBox}" IsChecked="True" Content="安装完成后立即启动 MacBridge"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Page 1: Installing / Uninstalling Progress -->
                <Grid x:Name="PageProgress" Visibility="Collapsed">
                    <Border Background="#121722" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TxtProgTitle" Grid.Row="0" Text="正在安装 MacBridge..." FontSize="17" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="TxtProgSub" Grid.Row="1" Text="正在复制程序文件并注册系统快捷方式" FontSize="12.5" Foreground="#94A3B8" Margin="0,5,0,14"/>
                            <ProgressBar x:Name="ProgBar" Grid.Row="2" Minimum="0" Maximum="100" Value="0" Height="7" Style="{StaticResource DarkProgressBar}" Margin="0,0,0,14"/>

                            <Border Grid.Row="3" Background="#080B10" BorderBrush="#182030" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <TextBox x:Name="TxtLog" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                         Foreground="#CBD5E1" FontFamily="Consolas, Menlo, monospace" FontSize="11.5"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Page 2: Completion Page (Install & Uninstall) -->
                <Grid x:Name="PageDone" Visibility="Collapsed">
                    <Border Background="#121722" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="24,24">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1.2" Margin="0,0,12,0">
                                    <Path Data="M9,17.5 L14.5,23 L25,11.5" Stroke="#34D399" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Border>
                                <TextBlock x:Name="TxtDoneTitle" Text="MacBridge 安装完成" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtDoneSub" Text="已准备就绪，接入 USB-C / USB-A 数据线后即可一键直连 Mac" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <Border Background="#080B10" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                <TextBlock x:Name="TxtDonePath" Text="安装路径: C:\Program Files\MacBridge" FontFamily="Consolas" FontSize="12" Foreground="#93C5FD" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock x:Name="TxtDoneTip" Text="" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Page 3: Uninstall Confirm Page -->
                <StackPanel x:Name="PageUninstall" Visibility="Collapsed">
                    <Border Background="#121722" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20,18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="TxtUninstTitle" Text="卸载 MacBridge" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="TxtUninstSub" Text="将移除 MacBridge 程序文件、快捷方式及系统卸载条目" FontSize="12.5" Foreground="#94A3B8" Margin="0,6,0,12" TextWrapping="Wrap"/>
                            <Border Background="#080B10" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <TextBlock x:Name="TxtUninstPath" Text="目标目录: C:\Program Files\MacBridge" FontFamily="Consolas" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="#121722" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="16,14">
                        <CheckBox x:Name="ChkRestoreDriver" Style="{StaticResource DarkCheckBox}" IsChecked="True" Content="同时还原 Apple USB 原厂驱动（WinUSB -&gt; usbccgp）"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Footer Bar: Bottom-Left GitHub Author Corner Card + Bottom-Right Action Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Corner GitHub Author Badge (Avatar + KSLengYu) -->
                <Button x:Name="BtnAuthor" Grid.Column="0" Click="BtnAuthor_Click" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#101725" BorderBrush="#1F2B40" BorderThickness="1" CornerRadius="10" Padding="8,5,12,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="30" Height="30" Stroke="#3B82F6" StrokeThickness="1.2" Margin="0,0,9,0">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="pack://application:,,,/avatar.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="KSLengYu" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                            <TextBlock x:Name="TxtAuthorRole" Text="  · GitHub" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="github.com/KSLengYu/MacBridge" FontSize="10.5" Foreground="#60A5FA"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#162136"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Primary / Secondary Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSecondary" Style="{StaticResource GhostBtn}" Content="取消" Click="BtnSecondary_Click" MinWidth="88"/>
                    <Button x:Name="BtnPrimary" Style="{StaticResource PrimaryBtn}" Content="立即安装" Click="BtnPrimary_Click" MinWidth="116" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
