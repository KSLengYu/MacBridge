<Window x:Class="MacBridgeUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MacBridge"
        Icon="pack://application:,,,/app.ico"
        Width="860" Height="640"
        MinWidth="740" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Background="#0B0E14"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#1E2636" BorderThickness="1" Background="#0B0E14">
        <Grid Margin="20,0,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar (removed USER-MODE pill, added Language toggle) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Background="#162136" BorderBrush="#263B5E" BorderThickness="1" Margin="0,0,10,0">
                        <Path Data="M6,12 H18 M9,8 L5,12 L9,16 M15,8 L19,12 L15,16"
                              Stroke="#60A5FA" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stretch="Uniform" Margin="4"/>
                    </Border>
                    <TextBlock Text="MacBridge" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnLang" Style="{StaticResource SmallPillBtn}" Content="中文 / EN" Click="BtnLang_Click" Margin="0,0,10,0" Padding="9,3"/>
                    <Button x:Name="BtnMin" Style="{StaticResource ChromeBtn}" Click="BtnMin_Click">
                        <Path Data="M0,4 H10" Stroke="#94A3B8" StrokeThickness="1.3" Width="10" Height="8" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource ChromeBtn}" Click="BtnClose_Click" Margin="4,0,0,0">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#94A3B8" StrokeThickness="1.3" Width="9" Height="9"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Hero Status & Action Card -->
            <Border Grid.Row="1" Background="#121722" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20,18" Margin="0,6,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="9" Height="9" Fill="#475569" Margin="0,6,9,0" VerticalAlignment="Top"/>
                                <TextBlock x:Name="TxtHeadline" Grid.Column="1" Text="正在检测 USB-C 端口..." FontSize="16.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                            </Grid>
                            <TextBlock x:Name="TxtSubline"
                                       Text="接入双 C 口线后可自动识别设备并完成 WinUSB 绑定"
                                       FontSize="12.5" Foreground="#94A3B8" Margin="18,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnConnect" Style="{StaticResource PrimaryBtn}" Content="一键识别并连接" Click="BtnConnect_Click" MinWidth="122" Padding="15,8"/>
                            <Button x:Name="BtnStop" Style="{StaticResource GhostBtn}" Content="断开通道" Click="BtnStop_Click" Margin="8,0,0,0" Padding="12,8" IsEnabled="False"/>
                            <Button x:Name="BtnRestore" Style="{StaticResource GhostBtn}" Content="安装驱动" Click="BtnRestore_Click" Margin="8,0,0,0" Padding="12,8"/>
                        </StackPanel>
                    </Grid>

                    <!-- Action Progress Bar -->
                    <StackPanel x:Name="ActionProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <ProgressBar x:Name="ActionProgressBar" Minimum="0" Maximum="100" Value="0" Height="5" Style="{StaticResource DarkProgressBar}"/>
                        <TextBlock x:Name="TxtProgressHint" Text="" FontSize="11.5" Foreground="#93C5FD" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3-Column Hardware Telemetry Cards -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Port, Driver & USB Physical Speed -->
                <Border Grid.Column="0" Background="#121722" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="15,13">
                    <StackPanel>
                        <TextBlock x:Name="LblCardPort" Text="端口与驱动状态" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtDevice" Text="未检测到 Mac 设备" FontSize="13.5" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,7,0,3" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtDriver" Text="当前驱动: --" FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtUsbSpeed" Text="线缆速率: --" FontSize="12" Foreground="#7DD3FC" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Direct IP & Finder SMB -->
                <Border Grid.Column="2" Background="#121722" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="15,13">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="LblCardAddr" Text="直连地址" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Button x:Name="BtnCopySmb" Style="{StaticResource SmallPillBtn}" Content="复制 SMB" Click="BtnCopySmb_Click" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="TxtAddrPair" Text="10.13.37.2  &lt;-&gt;  10.13.37.1" FontSize="13.5" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,7,0,3" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtSmbHint" Text="Mac 访达 Cmd+K: smb://10.13.37.2" FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Live Frames & Speed Test -->
                <Border Grid.Column="4" Background="#121722" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="15,13">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="LblCardTelemetry" Text="链路遥测" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Button x:Name="BtnSpeedTest" Style="{StaticResource SmallPillBtn}" Content="立即测速" Click="BtnSpeedTest_Click" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="TxtStats" Text="RX 0  /  TX 0" FontSize="13.5" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,7,0,3" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtPeerMac" Text="对端 MAC: 未学习" FontSize="12" Foreground="#94A3B8" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtLatency" Text="Pair 0 · RTT -- ms" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Terminal Log Drawer -->
            <Border Grid.Row="3" Background="#080B10" BorderBrush="#1A2232" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#151C28" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid>
                            <TextBlock x:Name="LblLogTitle" Text="实时日志" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Button x:Name="BtnClearLog" Content="清空" Click="BtnClearLog_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Foreground="#64748B" FontSize="11.5" Cursor="Hand" Padding="6,2"/>
                        </Grid>
                    </Border>

                    <TextBox x:Name="TxtLog"
                             Grid.Row="1"
                             Background="Transparent"
                             Foreground="#CBD5E1"
                             BorderThickness="0"
                             Padding="14,10"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </Border>

            <!-- GitHub Footer -->
            <Grid Grid.Row="4" Margin="2,10,2,0">
                <Button x:Name="BtnGitHub" Click="BtnGitHub_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2" ToolTip="https://github.com/KSLengYu">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="ghIcon"
                                      Data="M12,0.3C5.4,0.3,0,5.7,0,12.3c0,5.3,3.4,9.8,8.2,11.4c0.6,0.1,0.8-0.3,0.8-0.6c0-0.3,0-1.1,0-2.1c-3.3,0.7-4-1.6-4-1.6c-0.5-1.4-1.3-1.8-1.3-1.8c-1.1-0.7,0.1-0.7,0.1-0.7c1.2,0.1,1.8,1.2,1.8,1.2c1.1,1.8,2.8,1.3,3.5,1c0.1-0.8,0.4-1.3,0.8-1.6c-2.7-0.3-5.5-1.3-5.5-5.9c0-1.3,0.5-2.4,1.2-3.2c-0.1-0.3-0.5-1.5,0.1-3.2c0,0,1-0.3,3.3,1.2c1-0.3,2-0.4,3-0.4c1,0,2,0.1,3,0.4c2.3-1.6,3.3-1.2,3.3-1.2c0.7,1.7,0.2,2.9,0.1,3.2c0.8,0.8,1.2,1.9,1.2,3.2c0,4.6-2.8,5.6-5.5,5.9c0.4,0.4,0.8,1.1,0.8,2.2c0,1.6,0,2.9,0,3.3c0,0.3,0.2,0.7,0.8,0.6C20.6,22.1,24,17.6,24,12.3C24,5.7,18.6,0.3,12,0.3z"
                                      Fill="#64748B" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ghName" Text="KSLengYu" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ghIcon" Property="Fill" Value="#60A5FA"/>
                                    <Setter TargetName="ghName" Property="Foreground" Value="#F8FAFC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
